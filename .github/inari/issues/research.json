{
  "version": 1,
  "kind": "issue",
  "id": "research",
  "name": "Research",
  "description": "Pre-implementation research or technical validation",
  "title": "docs: research ",
  "sections": [
    {
      "id": "summary",
      "kind": "input",
      "type": "string",
      "label": "Summary",
      "description": "Research topic",
      "required": true,
      "element": "textarea"
    },
    {
      "id": "problem",
      "kind": "input",
      "type": "string",
      "label": "Problem",
      "description": "Unresolved question or decision gap",
      "required": true,
      "element": "textarea"
    },
    {
      "id": "failing_scenario",
      "kind": "input",
      "type": "string",
      "label": "Failing scenario",
      "description": "Observed failure, uncertainty, or concrete scenario the research must resolve; explain if no failure applies",
      "required": true,
      "element": "textarea"
    },
    {
      "id": "goal",
      "kind": "input",
      "type": "string",
      "label": "Goal",
      "description": "Decisions enabled by the research",
      "required": true,
      "element": "textarea"
    },
    {
      "id": "expected_contract",
      "kind": "input",
      "type": "string",
      "label": "Expected contract",
      "description": "Decision, evidence threshold, or invariant expected from the research",
      "required": true,
      "element": "textarea"
    },
    {
      "id": "non_goals",
      "kind": "input",
      "type": "string",
      "label": "Non-goals",
      "description": "Research and implementation excluded from this work",
      "required": true,
      "element": "textarea"
    },
    {
      "id": "acceptance",
      "kind": "input",
      "type": "string",
      "label": "Acceptance criteria",
      "description": "Completion criteria for evidence, comparison, and conclusion",
      "required": true,
      "element": "textarea",
      "defaultValue": "- [ ] "
    },
    {
      "id": "affected",
      "kind": "input",
      "type": "string",
      "label": "Affected areas",
      "description": "Areas affected by the decision",
      "required": true,
      "element": "textarea"
    },
    {
      "id": "test_layer",
      "kind": "input",
      "type": "string",
      "label": "Test layer",
      "description": "Experiment, contract, integration, fault, standards, or release layer needed for evidence",
      "required": true,
      "element": "textarea"
    },
    {
      "id": "risks",
      "kind": "input",
      "type": "string",
      "label": "Risks / compatibility",
      "description": "Risks from insufficient research or adoption",
      "required": true,
      "element": "textarea"
    },
    {
      "id": "release_impact",
      "kind": "input",
      "type": "string",
      "label": "Release impact",
      "description": "Package, publish, rollout, artifact, or explicit no-release impact",
      "required": true,
      "element": "textarea"
    },
    {
      "id": "security_impact",
      "kind": "input",
      "type": "string",
      "label": "Security impact",
      "description": "Security boundary impact, negative scenario, or explicit no-impact decision",
      "required": true,
      "element": "textarea"
    },
    {
      "id": "dependencies",
      "kind": "input",
      "type": "string",
      "label": "Dependencies",
      "description": "Required sources, environments, and prerequisite Issues",
      "required": true,
      "element": "textarea"
    },
    {
      "id": "implementation",
      "kind": "input",
      "type": "string",
      "label": "Implementation notes",
      "description": "Alternatives, measurement method, and deliverables",
      "required": true,
      "element": "textarea"
    }
  ]
}
