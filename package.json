{
  "name": "nawabari",
  "version": "0.15.0",
  "description": "A stable local Git session CLI exposed as git nawabari.",
  "type": "module",
  "bin": {
    "nawabari": "dist/index.js",
    "git-nawabari": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./state": {
      "types": "./dist/public-state.d.ts",
      "default": "./dist/public-state.js"
    },
    "./contract": {
      "types": "./dist/public-contract.d.ts",
      "default": "./dist/public-contract.js"
    },
    "./manifest": {
      "types": "./dist/product-state-manifest.d.ts",
      "default": "./dist/product-state-manifest.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "test": "node scripts/run-verification-lane.mjs all",
    "test:fast": "node scripts/run-verification-lane.mjs fast",
    "test:integration": "node scripts/run-verification-lane.mjs integration",
    "test:compiled-worker": "node scripts/run-verification-lane.mjs compiled-worker",
    "test:linux:system": "node scripts/run-verification-lane.mjs linux-system",
    "test:tgrep:conformance": "node --import tsx scripts/run-tgrep-runtime-conformance.mjs",
    "test:pnpm:conformance": "node --import tsx scripts/run-pnpm-middleware-runtime-conformance.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'scripts/**/*.mjs' 'eslint.config.mjs'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark:pnpm-worktree-install": "node scripts/benchmark-pnpm-worktree-install.mjs",
    "benchmark:protected-execution": "node scripts/benchmark-protected-execution.mjs",
    "smoke-test": "node scripts/smoke-test.mjs",
    "manifest:generate": "node --import tsx scripts/generate-state-diagram.mjs",
    "manifest:check": "node --import tsx scripts/generate-state-diagram.mjs --check",
    "test:package": "node scripts/run-package-suite.mjs",
    "test:package:protected": "node scripts/run-package-suite.mjs --require-protected-execution",
    "test:package:mottainai": "node scripts/run-mottainai-uid-handoff-gate.mjs",
    "governance:actions": "node scripts/validate-actions.mjs",
    "governance:workflows": "node scripts/validate-workflows.mjs",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run governance:actions && pnpm run governance:workflows && pnpm run test:compiled-worker && pnpm run test:linux:system && pnpm run test:package:protected",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint": "10.12.0",
    "gh-inari": "0.19.1",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0+sha512.wYum2HmT09Fky16JSPMrLAbuhUSH4GzY2GeBNC+z5btGNDZwNHEehoArqpw3vqkGzhkprQjXCITJfYAd8TOJpg==",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yohn-jp/nawabari.git"
  },
  "homepage": "https://github.com/yohn-jp/nawabari#readme",
  "bugs": {
    "url": "https://github.com/yohn-jp/nawabari/issues"
  },
  "keywords": [],
  "dependencies": {
    "xstate": "^5.33.2"
  }
}
